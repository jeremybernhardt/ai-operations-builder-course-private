{
  "name": "ai-operations-course-prototype",
  "version": "2.0.7",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "course": "bash scripts/start-course.sh",
    "install:ci": "bash scripts/install-ci.sh",
    "course:prepare": "python3 scripts/setup.py",
    "dev": "python3 scripts/setup.py && WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "npm run course:prepare && bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:reliability && python3 scripts/verify.py && npm run build && node --test tests/rendered-html.test.mjs",
    "test:reliability": "python3 -m unittest tests/test_reliability_scan.py && python3 scripts/reliability_scan.py",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "AI Operations Builder Course Prototype"
}
